---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import { SITE } from '@/site.config';

const tools = [
  'Python',
  'PyTorch',
  'scikit-learn',
  'TypeScript',
  'Astro',
  'React',
  'Flutter',
  'Node.js',
  'SQL',
];
---

<BaseLayout title="About" description={`A bit about ${SITE.name} and how they work.`}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <p class="text-ink-soft mb-6 font-mono text-xs tracking-[0.2em] uppercase">About</p>

    <h1 class="font-display text-ink max-w-xl text-3xl font-medium sm:text-4xl">
      {SITE.role}.
    </h1>

    <div class="prose prose-sm sm:prose-base mt-8 max-w-xl">
      <p>
        I build full-stack web applications and machine learning systems from the ground up,
        focusing on practical architecture, high reliability, and clean interfaces.
      </p>
      <p>
        Currently pursuing B.Tech in Computer Science (Data Science) at IPS Academy, Indore. My work
        spans developing real-time safety monitoring solutions as a Smart India Hackathon 2025
        National Finalist (GIRAKSHA) to publishing Scopus-indexed research on multi-disease prediction
        models.
      </p>
      <p>
        Whether architecting ML inference pipelines or shipping accessible frontend experiences, I
        prioritize modular systems, measurable accuracy, and performance over buzzwords.
      </p>
    </div>

    <div class="mt-10">
      <p class="text-ink-soft mb-3 font-mono text-xs tracking-[0.2em] uppercase">Tools</p>
      <ul class="flex flex-wrap gap-2">
        {
          tools.map((tool) => (
            <li class="border-line text-ink-soft rounded-full border px-3 py-1 font-mono text-xs">
              {tool}
            </li>
          ))
        }
      </ul>
    </div>

    <Button href={`mailto:${SITE.email}`} class="mt-10">Get in touch</Button>

  </section>
</BaseLayout>
